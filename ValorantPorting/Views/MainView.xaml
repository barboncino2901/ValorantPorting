<adonisCtrls:AdonisWindow x:Class="ValorantPorting.Views.MainView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:controls="clr-namespace:ValorantPorting.Views.Controls"
                          xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                          xmlns:adonisCtrls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                          xmlns:adonisExt="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                          Title="Valorant Porting" Width="1360" Height="820" MinWidth="1100" MinHeight="620" WindowStartupLocation="CenterScreen"
                          Loaded="OnLoaded">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding MenuCommand}" CommandParameter="File_Restart" />
    </Window.InputBindings>
    <adonisCtrls:AdonisWindow.Resources>
        <BooleanToVisibilityConverter x:Key="FavoriteVisibility" />
        <!-- right-click menu on every item (tiles, animations, maps) -->
        <ContextMenu x:Key="LibraryItemMenu" x:Shared="False" Opened="OnLibraryMenuOpened">
            <MenuItem Header="Add to favorites" Click="OnToggleFavoriteClick" />
        </ContextMenu>
        <Style x:Key="LibraryItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource LibraryItemMenu}" />
            <Setter Property="Padding" Value="4 3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151B23" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B222C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4655" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="AnimationItemMenu" x:Shared="False" Opened="OnLibraryMenuOpened">
            <MenuItem Header="Add to favorites" Click="OnToggleFavoriteClick" />
            <Separator />
            <MenuItem Header="Rename..." Click="OnRenameAnimationClick" />
            <MenuItem Header="Reset name" Click="OnResetAnimationNameClick" />
            <Separator />
            <MenuItem Header="Use as upper body (mix two)" Click="OnUseAsUpperBodyClick" />
            <MenuItem Header="Use as legs (mix two)" Click="OnUseAsLowerBodyClick" />
        </ContextMenu>
        <Style x:Key="AnimationItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource AnimationItemMenu}" />
            <Setter Property="Padding" Value="4 3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151B23" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B222C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4655" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the shell: sidebar sections, the Weapon Skins gun list, hidden tab headers (the sidebar picks the tab) -->
        <Style x:Key="HiddenTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#6B7686" />
            <Setter Property="Margin" Value="12 16 0 6" />
        </Style>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Foreground" Value="#AEB8C6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10 8" Margin="0 1">
                            <DockPanel>
                                <Border x:Name="Mark" DockPanel.Dock="Left" Width="3" Height="16" CornerRadius="1.5" Background="#FF4655" Margin="0 0 9 0" Visibility="Hidden" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151B23" />
                                <Setter Property="Foreground" Value="#ECE8E1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B222C" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB8C6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="22 8 10 8" Margin="0 1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151B23" />
                                <Setter Property="Foreground" Value="#ECE8E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GunItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10 6" Margin="0 1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151B23" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B222C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </adonisCtrls:AdonisWindow.Resources>
    <Grid Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- banners: an update, an outdated Blender add-on -->
        <StackPanel Grid.Row="0">
            <Border Visibility="{Binding UpdateVisibility}" Background="#24486F" Padding="14 7">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Later" Command="{Binding DismissUpdateCommand}" IsEnabled="{Binding UpdateIdle}" />
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="What's new" Command="{Binding ShowUpdateNotesCommand}" />
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Update now" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding UpdateIdle}"
                            ToolTip="Downloads the new version from GitHub, replaces this one and restarts. The old version is removed once the new one has started (and put back if it doesn't start)." />
                    <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border Visibility="{Binding AddonWarningVisibility}" Background="#8C5A2D" Padding="14 7">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="OK" Command="{Binding DismissAddonWarningCommand}" />
                    <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Update add-on in Blender" Command="{Binding UpdateAddonInBlenderCommand}"
                            Visibility="{Binding AddonUpdateButtonVisibility}" />
                    <TextBlock Text="{Binding AddonWarningText}" VerticalAlignment="Center" Foreground="White" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- sidebar: the sections, then settings and help -->
            <Border Grid.Column="0" Background="#0E1319" BorderBrush="#1A212A" BorderThickness="0 0 1 0">
                <DockPanel Margin="10 0 10 10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6 18 0 6">
                        <Border Width="32" Height="32" CornerRadius="7" Background="#FF4655">
                            <TextBlock Text="VP" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="15" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                            <TextBlock Text="Valorant Porting" FontWeight="SemiBold" FontSize="14.5" Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="#6B7686" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="#1A212A" Margin="4 8" />
                        <Button Style="{StaticResource SidebarButton}" Click="OnOpenMenuClick" Content="Settings">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Options" Command="{Binding MenuCommand}" CommandParameter="Settings_Options" />
                                    <MenuItem Header="First-Time Startup" Command="{Binding MenuCommand}" CommandParameter="Settings_Startup" />
                                    <MenuItem Header="Blender" Command="{Binding MenuCommand}" CommandParameter="Settings_Blender" />
                                    <MenuItem Header="Unreal" Command="{Binding MenuCommand}" CommandParameter="Settings_Unreal" />
                                    <Separator />
                                    <MenuItem Header="Open Assets Folder" Command="{Binding MenuCommand}" CommandParameter="Open_Assets" />
                                    <MenuItem Header="Open Data Folder" Command="{Binding MenuCommand}" CommandParameter="Open_Data" />
                                    <MenuItem Header="Open Exports Folder" Command="{Binding MenuCommand}" CommandParameter="Open_Exports" />
                                    <Separator />
                                    <MenuItem Header="Restart" InputGestureText="Ctrl+R" Command="{Binding MenuCommand}" CommandParameter="File_Restart" />
                                    <MenuItem Header="Quit" InputGestureText="Alt+F4" Command="{Binding MenuCommand}" CommandParameter="File_Quit" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}" Click="OnOpenMenuClick" Content="Help">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Discord Server" Command="{Binding MenuCommand}" CommandParameter="Help_Discord" />
                                    <MenuItem Header="GitHub Repo" Command="{Binding MenuCommand}" CommandParameter="Help_GitHub" />
                                    <MenuItem Header="Install / update the Blender add-on" Command="{Binding MenuCommand}" CommandParameter="Help_Addon" />
                                    <MenuItem Header="Check for updates" Command="{Binding MenuCommand}" CommandParameter="Help_Update" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding IsReady}">
                        <TextBlock Text="BROWSE" Style="{StaticResource SidebarLabel}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="0" Checked="OnNavChecked" AutomationProperties.Name="Agents" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Outfit.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Agents" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="1" Checked="OnNavChecked" AutomationProperties.Name="Weapon Skins">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Weapon.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Weapon Skins" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="2" Checked="OnNavChecked" AutomationProperties.Name="Gun Buddies">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Mesh.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Gun Buddies" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="3" Checked="OnNavChecked" AutomationProperties.Name="Abilities">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Pickaxe.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Abilities" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="4" Checked="OnNavChecked" AutomationProperties.Name="Animations">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Dance.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Animations" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="7" Checked="OnNavChecked" AutomationProperties.Name="Sounds">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Glider.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Sounds" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="5" Checked="OnNavChecked" AutomationProperties.Name="Maps">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Props.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Maps" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SidebarLabel}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="6" Checked="OnNavChecked" AutomationProperties.Name="Presets">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Backpack.png" Width="16" Height="16" Opacity="0.85" Margin="0 0 10 0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Presets" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Weapon Skins: the guns, by class -->
            <Border Grid.Column="1" Width="190" Visibility="{Binding GunSidebarVisibility}" Background="#0E1319" BorderBrush="#1A212A" BorderThickness="0 0 1 0">
                <DockPanel Margin="8 14 8 10">
                    <TextBlock DockPanel.Dock="Top" Text="GUNS" Style="{StaticResource SidebarLabel}" Margin="10 4 0 6" />
                    <ListBox ItemsSource="{Binding GunRows}" SelectedItem="{Binding SelectedGunRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource GunItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Label}" Foreground="#ECE8E1" FontSize="13" Visibility="{Binding RowVisibility}" />
                                    <TextBlock Text="{Binding Label}" Visibility="{Binding HeaderVisibility}" FontFamily="Bahnschrift SemiCondensed"
                                               FontSize="11.5" Foreground="#6B7686" Margin="0 8 0 0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- the section: title, search, the scene, the list -->
            <DockPanel Grid.Column="2" Margin="18 14 14 10">
                <Grid DockPanel.Dock="Top" Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTabTitle}" FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="30" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding ActiveTabSubtitle}" FontSize="12.5" Foreground="#6B7686" VerticalAlignment="Bottom" Margin="10 0 0 7" />
                    </StackPanel>
                    <DockPanel Grid.Column="1" MaxWidth="480" Margin="20 0 0 0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ComboBox DockPanel.Dock="Right" Width="130" Margin="6 0 0 0"
                                  ItemsSource="{Binding LibraryFilters}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding LibraryFilter, Mode=TwoWay}"
                                  ToolTip="Show everything, only your favorites (right-click an item to add it), or what you recently sent to Blender (newest first)." />
                        <TextBox adonisExt:WatermarkExtension.Watermark="Search..." TextChanged="OnSearchTextChanged" />
                    </DockPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Visibility="{Binding SceneVisibility}" Background="#141A22" BorderBrush="#232B36" BorderThickness="1" CornerRadius="6" Padding="10 6" Margin="0 0 0 10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Clear all" Command="{Binding ClearSceneCommand}"
                                ToolTip="Empties the whole scene (the ✕ on a piece removes only that one)." />
                        <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Save as preset..." Command="{Binding SaveCurrentSceneCommand}"
                                ToolTip="Keep this scene as an animation preset: it's then in the Animation Presets tab, to send again in one click." />
                        <Button DockPanel.Dock="Right" Margin="6 0 0 0" Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding SendSceneCommand}"
                                ToolTip="Imports the agent, puts the gun in their hand and plays the animations on each, in one go.">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="Send scene to Blender" VerticalAlignment="Center" Margin="5 0 0 0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Scene" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" Margin="0 0 10 0"
                                   ToolTip="A scene gathers an agent, a gun and their animations; &quot;Send scene to Blender&quot; in the bar at the top then brings them in together, the gun already in the agent&apos;s hand." />
                        <ItemsControl ItemsSource="{Binding SceneParts}" VerticalAlignment="Center"
                                      ToolTip="Add pieces with &quot;Add to scene&quot;: agents and gun skins (with their options) on the right, abilities in the Abilities tab, animations in the Animations tab. Adding again replaces that piece; ✕ removes it.">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E2630" CornerRadius="3" Padding="7 1 2 1" Margin="0 1 6 1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Foreground="White" MaxWidth="320" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Label, Mode=OneWay, StringFormat='{}{0}: '}" Foreground="#A9B4C6" />
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                            <Button Content="✕" Padding="5 0" Margin="4 0 0 0" FontSize="10" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ClearScenePartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Key}" ToolTip="Remove only this from the scene" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Grid>
                        <GroupBox Padding="0" BorderThickness="0" adonisExt:LayerExtension.Layer="1" Background="Transparent">
                            <TabControl Name="AssetControls" SelectionChanged="OnAssetTabSelectionChanged" Padding="0" BorderThickness="0" Background="Transparent"
                                        IsEnabled="{Binding IsReady}">
                            <!-- the sidebar picks the tab: only its content shows -->
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Agents"
                                                               ImageSource="/ValorantPorting;component/Resources/Outfit.png" />
                                    </TabItem.Header>
                                    <ListBox ItemsSource="{Binding Outfits}" SelectionChanged="OnAssetSelectionChanged" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:UniformGridPanel IsItemsHost="True" MinItemHeight="108" Rows="5" Columns="10"
                                                                           VerticalAlignment="Top" HorizontalAlignment="Left" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Weapon Skins"
                                                               ImageSource="/ValorantPorting;component/Resources/Weapon.png" />
                                    </TabItem.Header>
                                    <ListBox ItemsSource="{Binding Weapons}" SelectionChanged="OnAssetSelectionChanged" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:UniformGridPanel IsItemsHost="True" MinItemHeight="108" Rows="5" Columns="6"
                                                                           VerticalAlignment="Top" HorizontalAlignment="Left" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Gun Buddies"
                                                               ImageSource="/ValorantPorting;component/Resources/Mesh.png" />
                                    </TabItem.Header>
                                    <ListBox ItemsSource="{Binding Gunbuddies}" SelectionChanged="OnAssetSelectionChanged" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:UniformGridPanel IsItemsHost="True" MinItemHeight="108" Rows="5" Columns="8"
                                                                           VerticalAlignment="Top" HorizontalAlignment="Left" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Abilities"
                                                               ImageSource="/ValorantPorting;component/Resources/Mesh.png" />
                                    </TabItem.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListBox Grid.Row="0" x:Name="AbilityList" ItemsSource="{Binding Abilities}"
                                                 SelectedItem="{Binding SelectedAbility, Mode=TwoWay}"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="OnAbilityDoubleClick" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="2">
                                                        <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0 0 8 0" Background="#161C24" CornerRadius="4">
                                                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Width="28" Height="28"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="★ " Foreground="Gold" FontWeight="SemiBold"
                                                                           Visibility="{Binding IsFavorite, Converter={StaticResource FavoriteVisibility}}" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Animations"
                                                               ImageSource="/ValorantPorting;component/Resources/Dance.png" />
                                    </TabItem.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="{adonisUi:Space 1}">
                                            <TextBlock DockPanel.Dock="Left" Text="Show animations for:" VerticalAlignment="Center" Margin="0 0 8 0" />
                                            <ComboBox ItemsSource="{Binding AnimationFilters}" SelectedItem="{Binding SelectedAnimationFilter, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                                      ToolTip="Follow Blender selection: filters to the Valorant model selected in Blender (3rd person, 1st person or gun). Pick an entry to lock the filter, or All animations." />
                                        </DockPanel>
                                        <ListBox Grid.Row="1" x:Name="AnimationList" ItemsSource="{Binding Animations}"
                                                 SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="OnAnimationDoubleClick" ItemContainerStyle="{StaticResource AnimationItemContainer}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2" ToolTip="{Binding Folder}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="★ " Foreground="Gold" FontWeight="SemiBold"
                                                                       Visibility="{Binding IsFavorite, Converter={StaticResource FavoriteVisibility}}" />
                                                            <Border Background="#2A3340" CornerRadius="3" Padding="5 0" Margin="0 1 6 1" VerticalAlignment="Center"
                                                                    ToolTip="The model this animation is for">
                                                                <TextBlock Text="{Binding ModelTag}" FontSize="10.5" Foreground="#D6E2F5" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Maps"
                                                               ImageSource="/ValorantPorting;component/Resources/Props.png" />
                                    </TabItem.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListBox Grid.Row="0" x:Name="MapList" ItemsSource="{Binding Maps}"
                                                 SelectedItem="{Binding SelectedMap, Mode=TwoWay}" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="★ " Foreground="Gold" FontWeight="SemiBold"
                                                                       Visibility="{Binding IsFavorite, Converter={StaticResource FavoriteVisibility}}" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Presets" ToolTip="Animation presets: saved scenes to send to Blender again in one click"
                                                               ImageSource="/ValorantPorting;component/Resources/Backpack.png" />
                                    </TabItem.Header>
                                    <Grid>
                                        <ListBox x:Name="SceneList" ItemsSource="{Binding SavedSceneList}"
                                                 SelectedItem="{Binding SelectedSavedScene, Mode=TwoWay}" MouseDoubleClick="OnSavedSceneDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SavedText}" FontSize="10.5" Opacity="0.5" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Visibility="{Binding NoSavedScenesVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" Opacity="0.6" FontSize="14" Margin="40" IsHitTestVisible="False"
                                                   Text="No animation presets yet. Fill the scene bar with &quot;Add to scene&quot; (agent, gun skin, animations), then click &quot;Save as preset...&quot; in the bar: it shows up here, to send again in one click." />
                                    </Grid>
                                </TabItem>
                                <TabItem Style="{StaticResource HiddenTab}">
                                    <TabItem.Header>
                                        <controls:TextWithIcon Label="Sounds" ToolTip="The game's sound effects and voice lines: search, listen, save as .wav or put in Blender"
                                                               ImageSource="/ValorantPorting;component/Resources/Props.png" />
                                    </TabItem.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="{adonisUi:Space 1}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Show:" VerticalAlignment="Center" Margin="0 0 8 0" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding SoundCategories}" SelectedItem="{Binding SoundCategory, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="2" Text="Only:" VerticalAlignment="Center" Margin="12 0 8 0" Visibility="{Binding SoundGroupVisibility}" />
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding SoundGroups}" SelectedItem="{Binding SoundGroup, Mode=TwoWay}"
                                                      Visibility="{Binding SoundGroupVisibility}"
                                                      ToolTip="One gun skin, ability, agent or map of this category" />
                                        </Grid>
                                        <ListBox Grid.Row="1" x:Name="SoundList" ItemsSource="{Binding SoundRows}"
                                                 SelectedItem="{Binding SelectedSoundRow, Mode=TwoWay}"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="OnSoundDoubleClick" ItemContainerStyle="{StaticResource LibraryItemContainer}">
                                            <ListBox.Resources>
                                                <DataTemplate DataType="{x:Type controls:SoundHeader}">
                                                    <Border Background="#161C24" CornerRadius="3" Padding="8 4" Margin="0 6 0 1" IsHitTestVisible="False">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="10 0 0 0" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type controls:SoundItem}">
                                                    <StackPanel Orientation="Horizontal" Margin="10 1 2 1" ToolTip="{Binding Details}">
                                                        <TextBlock Text="★ " Foreground="Gold" FontWeight="SemiBold"
                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource FavoriteVisibility}}" />
                                                        <TextBlock Text="{Binding Short}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.Resources>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </GroupBox>
                        <Grid Visibility="{Binding LoadingVisibility}">
                            <Rectangle Fill="#000000" Opacity="0.0" />
                            <ContentControl ContentTemplate="{DynamicResource {x:Static adonisUi:Templates.LoadingBars}}"
                                            Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                            Width="48"
                                            Height="48"
                                            Focusable="False" />
                        </Grid>
                </Grid>
            </DockPanel>

            <!-- the picked item's options / the section's panel -->
            <Border Grid.Column="3" Background="#0E1319" BorderBrush="#1A212A" BorderThickness="1 0 0 0" Padding="6 8 6 6">
                    <GroupBox Padding="{adonisUi:Space 0}" adonisExt:LayerExtension.Layer="1" BorderThickness="0" Background="Transparent">
                      <Grid>
                        <!-- Agents / skins / buddies before one is picked -->
                        <TextBlock Visibility="{Binding AssetHintVisibility}" Margin="16" TextWrapping="Wrap" Opacity="0.6" FontSize="14"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Text="Click an item on the left to see its options (variants, upgrade levels, models) and send it to Blender." />
                
                        <!-- Animations tab: the selected animation (apply it as it is), and a mix of two built from it -->
                        <ScrollViewer Visibility="{Binding AnimationPanelVisibility}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{adonisUi:Space 1}">
                                <Separator Style="{StaticResource NamedSeparator}" Tag="ANIMATION" />
                                <TextBlock Text="{Binding SelectedAnimationText}" FontSize="18" TextWrapping="Wrap" Margin="0 4 0 0" />
                                <StackPanel Orientation="Horizontal" Margin="0 2 0 0" Visibility="{Binding SelectedAnimationVisibility}">
                                    <Border Background="#2A3340" CornerRadius="3" Padding="5 0" Margin="0 1 6 1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedAnimation.ModelTag}" FontSize="10.5" Foreground="#D6E2F5" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedAnimation.Name}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DockPanel Margin="0 10 0 0" Visibility="{Binding RepeatSingleVisibility}"
                                           ToolTip="This animation loops (a run, walk or idle): it can play several times in a row.">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding RepeatCount, Mode=TwoWay}" ItemStringFormat="×{0}" Width="70" />
                                    <TextBlock Text="Repeat" VerticalAlignment="Center" />
                                </DockPanel>
                                <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding ExportAnimationBlenderCommand}" Margin="0 12 0 0" Padding="8 8"
                                        ToolTip="Applies this animation to the agent or gun selected in Blender (double-clicking it in the list does the same).">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Apply in Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Add to scene" Command="{Binding AddAnimationToSceneCommand}" Margin="0 6 0 0" Padding="8 5"
                                        ToolTip="A scene gathers an agent, a gun and their animations; &quot;Send scene to Blender&quot; in the bar at the top then brings them in together, the gun already in the agent&apos;s hand." />
                                <TextBlock Margin="0 8 0 0" TextWrapping="Wrap" Opacity="0.6" FontSize="11"
                                           Text="Click the agent or gun in Blender first: the animation goes on it." />
                                <DockPanel Margin="0 10 0 0"
                                           ToolTip="Animations that make sounds in game (gun handling, ability casts, ultimates) bring them along, and the voice line said with them (an ultimate's): they go into Blender's Video Sequencer, each at its moment. Footsteps of walks and runs aren't included: the game adds them while playing.">
                                    <TextBlock DockPanel.Dock="Left" Text="Bring along:" VerticalAlignment="Center" Margin="0 0 10 0" />
                                    <CheckBox Content="Sound effects" IsChecked="{Binding IncludeSoundEffects}" VerticalAlignment="Center" Margin="0 0 14 0"
                                              ToolTip="Gun handling, ability equips, casts, attacks and their loops, each at its moment." />
                                    <CheckBox Content="Voice lines" IsChecked="{Binding IncludeVoiceLines}" VerticalAlignment="Center"
                                              ToolTip="The line the agent says when first using an ability or ultimate (equip / cast), not on re-equips." />
                                </DockPanel>
                
                                <Separator Style="{StaticResource NamedSeparator}" Tag="MIX TWO ANIMATIONS" Margin="0 16 0 0" />
                                <TextBlock Margin="0 4 0 8" TextWrapping="Wrap" Opacity="0.75"
                                           Text="Legs from one animation, the rest of the body from another (e.g. an equip while running). Put the selected animation in the mix:" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Use as upper body" Command="{Binding UseSelectedAsUpperCommand}" Padding="6 5" />
                                    <Button Grid.Column="2" Content="Use as legs" Command="{Binding UseSelectedAsLowerCommand}" Padding="6 5" />
                                </Grid>
                
                                <Border Visibility="{Binding CombineVisibility}" Background="#161C24" CornerRadius="4" Padding="10 8" Margin="0 10 0 0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearUpperCommand}" Padding="7 1" Margin="6 0 0 0" ToolTip="Empty this slot" />
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="Upper body   " Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
                                                <Run Text="{Binding CombineUpperText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DockPanel>
                                        <DockPanel Margin="0 6 0 0">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClearLowerCommand}" Padding="7 1" Margin="6 0 0 0" ToolTip="Empty this slot" />
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="Legs   " Foreground="{DynamicResource {x:Static adonisUi:Brushes.DisabledForegroundBrush}}" />
                                                <Run Text="{Binding CombineLowerText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DockPanel>
                                        <DockPanel Margin="0 10 0 0" Visibility="{Binding RepeatCombinedVisibility}"
                                                   ToolTip="One of the two loops (a run, walk or idle): the mix can play several times in a row.">
                                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding RepeatCount, Mode=TwoWay}" ItemStringFormat="×{0}" Width="70" />
                                            <TextBlock Text="Repeat" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding ExportCombinedBlenderCommand}" Margin="0 10 0 0" Padding="8 8"
                                                ToolTip="A looping half repeats to cover the other; a shorter one-shot holds its last pose.">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="Apply mix in Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Add mix to scene" Command="{Binding AddCombinedToSceneCommand}" Margin="0 6 0 0" Padding="8 5"
                                                ToolTip="A scene gathers an agent, a gun and their animations; &quot;Send scene to Blender&quot; in the bar at the top then brings them in together, the gun already in the agent&apos;s hand." />
                                    </StackPanel>
                                </Border>
                
                                <TextBlock Margin="0 16 0 0" TextWrapping="Wrap" Opacity="0.6" FontSize="11" Text="A scene gathers an agent, a gun and their animations; &quot;Send scene to Blender&quot; in the bar at the top then brings them in together, the gun already in the agent&apos;s hand." />
                            </StackPanel>
                        </ScrollViewer>
                
                        <!-- Abilities tab -->
                        <ScrollViewer Visibility="{Binding AbilityPanelVisibility}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{adonisUi:Space 1}">
                                <Separator Style="{StaticResource NamedSeparator}" Tag="ABILITY" />
                                <DockPanel Margin="0 6 0 0">
                                    <Border DockPanel.Dock="Left" Width="52" Height="52" Margin="0 0 10 0" Background="#161C24" CornerRadius="6"
                                            Visibility="{Binding SelectedAbilityVisibility}">
                                        <Image Source="{Binding SelectedAbility.IconUrl, TargetNullValue={x:Null}}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedAbility.Title, TargetNullValue='Pick an ability model on the left.', FallbackValue='Pick an ability model on the left.'}"
                                               FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding SelectedAbility.Details}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0 4 0 0" />
                                <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding ExportAbilityBlenderCommand}" Margin="0 12 0 0" Padding="8 7"
                                        ToolTip="Imports this model into Blender (double-clicking it does the same).">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Send to Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Add to scene" Command="{Binding AddAbilityToSceneCommand}" Margin="0 6 0 0" Padding="8 5"
                                        ToolTip="Puts this model in the scene bar: sent with the scene, it goes in the agent's hands where the game holds it, and an ability animation added to the scene (Animations tab) plays on it. Saved in presets too." />
                                <Border Background="#161C24" CornerRadius="4" Padding="10 8" Margin="0 12 0 0">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• Select an agent in Blender before sending it and it goes in their hands, like a gun." />
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• Models made of several parts come in assembled, as in game." />
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• Their animations are in the Animations tab: click the model in Blender and the list shows its animations." />
                                        <TextBlock TextWrapping="Wrap" Text="• Abilities that are only effects (smokes, walls, fire) have no model. Models drawn entirely with effects (like Fade&apos;s Haunt orb) aren&apos;t listed: their look can&apos;t be exported." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                
                        <!-- Scenes tab -->
                        <ScrollViewer Visibility="{Binding ScenePanelVisibility}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{adonisUi:Space 1}">
                                <Separator Style="{StaticResource NamedSeparator}" Tag="ANIMATION PRESET" />
                                <TextBlock Visibility="{Binding NoSavedSceneSelectedVisibility}" Margin="0 6 0 0" TextWrapping="Wrap" Opacity="0.6"
                                           Text="Pick a preset on the left (double-click sends it to Blender)." />
                                <StackPanel Visibility="{Binding SelectedSavedSceneVisibility}">
                                    <TextBlock Text="{Binding SelectedSavedScene.Name}" FontSize="18" TextWrapping="Wrap" Margin="0 4 0 2" />
                                    <TextBlock Text="{Binding SelectedSavedScene.SavedText}" FontSize="11" Opacity="0.6" />
                                    <Border Background="#161C24" CornerRadius="4" Padding="10 8" Margin="0 10 0 0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Agent" Opacity="0.6" Margin="0 0 10 4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSavedScene.AgentText}" TextWrapping="Wrap" Margin="0 0 0 4" />
                                            <TextBlock Grid.Row="1" Text="Gun" Opacity="0.6" Margin="0 0 10 4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSavedScene.GunText}" TextWrapping="Wrap" Margin="0 0 0 4" />
                                            <TextBlock Grid.Row="2" Text="Agent animation" Opacity="0.6" Margin="0 0 10 4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSavedScene.AgentAnimationText}" TextWrapping="Wrap" Margin="0 0 0 4" />
                                            <TextBlock Grid.Row="3" Text="Gun animation" Opacity="0.6" Margin="0 0 10 0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSavedScene.GunAnimationText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="4" Text="Ability" Opacity="0.6" Margin="0 4 10 0" Visibility="{Binding SelectedSavedScene.AbilityVisibility}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSavedScene.AbilityText}" TextWrapping="Wrap" Margin="0 4 0 0"
                                                       Visibility="{Binding SelectedSavedScene.AbilityVisibility}" />
                                            <TextBlock Grid.Row="5" Text="Ability animation" Opacity="0.6" Margin="0 4 10 0" Visibility="{Binding SelectedSavedScene.AbilityVisibility}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSavedScene.AbilityAnimationText}" TextWrapping="Wrap" Margin="0 4 0 0"
                                                       Visibility="{Binding SelectedSavedScene.AbilityVisibility}" />
                                        </Grid>
                                    </Border>
                                    <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding SendSelectedSavedSceneCommand}" Margin="0 12 0 0" Padding="8 8"
                                            ToolTip="Brings the whole preset into Blender: agent, gun in hand, animations (double-clicking it does the same).">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="Send to Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Load into the scene bar" Command="{Binding LoadSelectedSavedSceneCommand}" Margin="0 6 0 0" Padding="8 5"
                                            ToolTip="Puts it in the scene bar at the top, to change something before sending it (or saving it again)." />
                                    <Grid Margin="0 6 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Rename..." Command="{Binding RenameSelectedSavedSceneCommand}" Padding="8 5" />
                                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteSelectedSavedSceneCommand}" Padding="8 5" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                
                        <!-- Sounds tab -->
                        <ScrollViewer Visibility="{Binding SoundPanelVisibility}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{adonisUi:Space 1}">
                                <Separator Style="{StaticResource NamedSeparator}" Tag="SOUND" />
                                <TextBlock Visibility="{Binding NoSoundSelectedVisibility}" Margin="0 6 0 0" TextWrapping="Wrap" Opacity="0.6"
                                           Text="Search for a sound in plain words (&quot;vandal reload&quot;, &quot;jett dash&quot;, &quot;spike defuse&quot;, &quot;boom bot&quot;), pick one, then Play to listen." />
                                <StackPanel Visibility="{Binding SelectedSoundVisibility}">
                                    <TextBlock Text="{Binding SelectedSound.Title}" FontSize="18" TextWrapping="Wrap" Margin="0 4 0 2" />
                                    <TextBlock Text="{Binding SelectedSound.Details}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    <DockPanel Margin="0 10 0 0" Visibility="{Binding SoundLanguageVisibility}">
                                        <TextBlock DockPanel.Dock="Left" Text="Language" VerticalAlignment="Center" Margin="0 0 8 0" />
                                        <ComboBox ItemsSource="{Binding SoundLanguages}" SelectedItem="{Binding SoundLanguage, Mode=TwoWay}" />
                                    </DockPanel>
                                    <TextBlock Margin="0 10 0 4" TextWrapping="Wrap" Opacity="0.75"
                                               Text="The game plays one of these at random (some are for 1st or 3rd person):" />
                                    <ListBox ItemsSource="{Binding SoundVariants}" SelectedItem="{Binding SelectedSoundVariant, Mode=TwoWay}"
                                             MaxHeight="180" MouseDoubleClick="OnSoundVariantDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Details}" FontSize="10.5" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding SoundStatus}" Margin="0 6 0 0" TextWrapping="Wrap" Opacity="0.7" />
                                    <Grid Margin="0 10 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="▶  Play" Command="{Binding PlaySoundCommand}" Padding="8 6" ToolTip="Listen to the selected version (double-clicking it does the same)." />
                                        <Button Grid.Column="2" Content="■  Stop" Command="{Binding StopSoundCommand}" Padding="8 6" />
                                    </Grid>
                                    <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding SendSoundToBlenderCommand}" Margin="0 10 0 0" Padding="8 8"
                                            ToolTip="Adds the selected version to Blender's Video Sequencer at the current frame: it plays with the timeline and goes into renders with audio (double-clicking the sound in the list does the same).">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="Send to Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0 6 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Save as .wav..." Command="{Binding SaveSoundCommand}" Padding="8 5"
                                                ToolTip="Saves the selected version as a .wav file, to use in any video editor." />
                                        <Button Grid.Column="2" Content="Save all versions..." Command="{Binding SaveAllSoundVersionsCommand}" Padding="8 5"
                                                ToolTip="Saves every version shown above into a folder you pick." />
                                    </Grid>
                                </StackPanel>
                                <Border Background="#161C24" CornerRadius="4" Padding="10 8" Margin="0 14 0 0">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• Animations bring their own sounds too (gun handling, ability casts, ultimates): see &quot;Bring along&quot; in the Animations section." />
                                        <TextBlock TextWrapping="Wrap" Text="• In Blender, sounds are in the Video Sequencer. To hear them in a render, pick an audio codec in Output Properties &gt; Encoding." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                
                        <!-- Maps tab -->
                        <ScrollViewer Visibility="{Binding MapPanelVisibility}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="{adonisUi:Space 1}">
                                <Separator Style="{StaticResource NamedSeparator}" Tag="MAP" />
                                <TextBlock Text="{Binding SelectedMap.Name, TargetNullValue='Pick a map on the left.', FallbackValue='Pick a map on the left.'}"
                                           FontSize="18" TextWrapping="Wrap" Margin="0 4 0 2" />
                                <TextBlock Text="{Binding SelectedMap.Details}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding ExportMapBlenderCommand}" Margin="0 12 0 0" Padding="8 7">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ValorantPorting;component/Resources/Blender.png" VerticalAlignment="Center" Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Export map to Blender" VerticalAlignment="Center" Margin="6 0 0 0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Border Background="#161C24" CornerRadius="4" Padding="10 8" Margin="0 12 0 0">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• Experimental." />
                                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6" Text="• The first export of a map can take several minutes and a few GB of disk space; later ones are faster." />
                                        <TextBlock TextWrapping="Wrap" Text="• Blender freezes while it imports a map: that's normal, give it a minute." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                
                        <!-- Agents / skins / buddies: the picked item's options -->
                        <Grid Visibility="{Binding StyleVisibility}" Margin="{adonisUi:Space 1}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.25*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0.5*" />
                                <RowDefinition Height="{adonisUi:Space 1}" />
                                <RowDefinition Height="0.5*" />
                
                            </Grid.RowDefinitions>
                
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Image Source="{Binding StyleImage}" Width="88" Height="88" />
                                <StackPanel Margin="{adonisUi:Space 1}" Width="256" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentAsset.DisplayName}" FontSize="21"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <Separator Grid.Row="1" Style="{StaticResource NamedSeparator}" Tag="STYLES" />
                
                            <ScrollViewer Grid.Row="2" PreviewMouseWheel="StupidIdiotBadScroll">
                                <StackPanel>
                                <DockPanel Visibility="{Binding LevelVisibility}" Margin="0 0 0 6">
                                    <TextBlock Text="Upgrade level" VerticalAlignment="Center" Width="100" />
                                    <ComboBox ItemsSource="{Binding LevelOptions}" SelectedIndex="{Binding SelectedLevel, Mode=TwoWay}"
                                              ToolTip="Skins with upgrades change their model at some levels. Variants (chromas) only exist on the fully upgraded skin." />
                                </DockPanel>
                                <DockPanel Visibility="{Binding ModelVisibility}" Margin="0 0 0 6">
                                    <TextBlock Text="Models" VerticalAlignment="Center" Width="100" />
                                    <ComboBox ItemsSource="{Binding ModelOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedModels, Mode=TwoWay}"
                                              ToolTip="3rd person = the full body model; 1st person = the arms you see in game; character select = the agent select screen model." />
                                </DockPanel>
                                <CheckBox Visibility="{Binding FirstPersonCameraVisibility}" IsChecked="{Binding FirstPersonCamera, Mode=TwoWay}"
                                          Content="Add a 1st person camera" Margin="0 0 0 6"
                                          ToolTip="Adds a camera where the player's eyes are (the arms' Camera bone), with Valorant's field of view. It follows the arms' animations." />
                                <ItemsControl ItemsSource="{Binding Styles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                
                            <Separator Grid.Row="3" Style="{StaticResource NamedSeparator}" Tag="EXPORT" />
                
                            <DockPanel Grid.Row="4">
                            <Button DockPanel.Dock="Right" Margin="6 0 0 0" Content="Add to scene" Command="{Binding AddAssetToSceneCommand}"
                                    Visibility="{Binding AddToSceneVisibility}"
                                    ToolTip="Puts this agent / gun skin, with the options above, in the scene. A scene gathers an agent, a gun and their animations; &quot;Send scene to Blender&quot; in the bar at the top then brings them in together, the gun already in the agent&apos;s hand." />
                            <Button Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Command="{Binding ExportBlenderCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ValorantPorting;component/Resources/Blender.png"
                                               VerticalAlignment="Center" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Send to Blender" VerticalAlignment="Center" Margin="5 0 0 0" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            </DockPanel>
                
                            <Button Grid.Row="6" Command="{Binding ExportUnrealCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/ValorantPorting;component/Resources/Unreal.png"
                                               VerticalAlignment="Center" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="Send to Unreal Engine" VerticalAlignment="Center" Margin="5 0 0 0" />
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                      </Grid>
                    </GroupBox>
            </Border>
        </Grid>

        <!-- log: collapses to its bar -->
        <Border Grid.Row="2" Background="#0E1319" BorderBrush="#1A212A" BorderThickness="0 1 0 0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12 6">
                    <ToggleButton x:Name="LogToggle" DockPanel.Dock="Left" IsChecked="True" Padding="10 3" Content="Log"
                                  ToolTip="Show or hide the log" />
                    <TextBlock Text="{Binding LogHint}" Foreground="#6B7686" FontSize="11.5" VerticalAlignment="Center" Margin="12 0 0 0" />
                </DockPanel>
                <Grid Height="120" Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource FavoriteVisibility}}">
                    <RichTextBox Name="LoggerRtb" Margin="{adonisUi:Space 1}" Block.LineHeight="2.0" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0">
                    <FlowDocument PageWidth="{Binding ElementName=LoggerBox, Path=ActualWidth}" />
                </RichTextBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</adonisCtrls:AdonisWindow>
