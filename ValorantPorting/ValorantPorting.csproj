<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>ValorantPorting.ico</ApplicationIcon>
        <Version>1.14.0</Version>
        <RootNamespace>ValorantPorting</RootNamespace>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>
    <!-- The Blender add-on, zipped from ..\ValorantPortingBlender on every build and built into the app: the app keeps
         Blender's copy up to date (BlenderAddonInstaller) -->
    <Target Name="PackBlenderAddon" BeforeTargets="PrepareForBuild">
        <ItemGroup>
            <BlenderAddonFile Include="..\ValorantPortingBlender\**\*" Exclude="..\ValorantPortingBlender\**\__pycache__\**;..\ValorantPortingBlender\**\*.pyc" />
        </ItemGroup>
        <RemoveDir Directories="$(IntermediateOutputPath)blender-addon" />
        <Copy SourceFiles="@(BlenderAddonFile)" DestinationFiles="@(BlenderAddonFile->'$(IntermediateOutputPath)blender-addon\ValorantPortingBlender\%(RecursiveDir)%(Filename)%(Extension)')" />
        <ZipDirectory SourceDirectory="$(IntermediateOutputPath)blender-addon" DestinationFile="$(IntermediateOutputPath)ValorantPortingBlender.zip" Overwrite="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(IntermediateOutputPath)ValorantPortingBlender.zip" LogicalName="ValorantPortingBlender.zip" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <PackageReference Include="AdonisUI" Version="1.17.1"/>
        <PackageReference Include="AdonisUI.ClassicTheme" Version="1.17.1"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0"/>
        <PackageReference Include="DiscordRichPresence" Version="1.0.175"/>
        <PackageReference Include="DotNetZip" Version="1.16.0"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1"/>
        <PackageReference Include="RestSharp" Version="108.0.3-alpha.0.5"/>
        <PackageReference Include="RestSharp.Serializers.NewtonsoftJson" Version="108.0.3-alpha.0.5"/>
        <PackageReference Include="YamlDotNet.NetCore" Version="1.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj"/>
        <ProjectReference Include="..\CUE4Parse\CUE4Parse\CUE4Parse.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
        <!-- CUE4Parse-Natives.dll (animation decompression), built from CUE4Parse/CUE4Parse-Natives (see the workflow);
             the app unpacks it next to itself, so it isn't a separate download -->
        <EmbeddedResource Include="Natives\CUE4Parse-Natives.dll" LogicalName="CUE4Parse-Natives.dll" Condition="Exists('Natives\CUE4Parse-Natives.dll')" />
        <!-- vgmstream (github.com/vgmstream/vgmstream, ISC license): turns the game's Wwise sounds into .wav; the release
             workflow downloads a pinned build, the app unpacks it into .data the first time a sound is used -->
        <EmbeddedResource Include="Natives\vgmstream-win64.zip" LogicalName="vgmstream.zip" Condition="Exists('Natives\vgmstream-win64.zip')" />
        <Resource Include="Resources\Backpack.png"/>
        <Resource Include="Resources\Dance.png"/>
        <Resource Include="Resources\Glider.png"/>
        <Resource Include="Resources\Mesh.png"/>
        <Resource Include="Resources\Outfit.png"/>
        <Resource Include="Resources\Pickaxe.png"/>
        <Resource Include="Resources\Props.png"/>
        <Resource Include="Resources\Vehicle.png"/>
        <Resource Include="Resources\Weapon.png"/>
        <Resource Include="Resources\Unreal.png"/>
        <Resource Include="Resources\Blender.png"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="ViewModels\BundleDownloaderViewModel.cs"/>
    </ItemGroup>
</Project>
